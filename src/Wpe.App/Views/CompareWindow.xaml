<Window x:Class="Wpe.App.Views.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="封包对比" Height="560" Width="920"
        MinHeight="400" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource Brush.Window}"
            BorderBrush="{StaticResource Brush.BorderDefault}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="{StaticResource Brush.Window}">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="封包对比（原始 vs 修改）" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{StaticResource Brush.TextPrimary}" />
                </StackPanel>
                <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseButton}" Click="OnClose"
                        HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="关闭">
                    <Path Data="{StaticResource Icon.Close}" Stroke="{Binding Foreground,
                          RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="20,8,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 原始 -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Effect="{StaticResource Shadow.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="RawTitle" Grid.Row="0" Text="原始数据" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,10" />
                        <Border Grid.Row="1" Background="{StaticResource Brush.Sunken}"
                                CornerRadius="{StaticResource Radius.Md}" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBlock x:Name="RawDump" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                           Foreground="{StaticResource Brush.TextPrimary}" TextWrapping="NoWrap" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <!-- 修改 -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Effect="{StaticResource Shadow.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ModTitle" Grid.Row="0" Text="修改数据" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,10" />
                        <Border Grid.Row="1" Background="{StaticResource Brush.Sunken}"
                                CornerRadius="{StaticResource Radius.Md}" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBlock x:Name="ModDump" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                           Foreground="{StaticResource Brush.TextPrimary}" TextWrapping="NoWrap" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
