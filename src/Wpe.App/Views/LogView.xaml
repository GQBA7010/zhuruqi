<UserControl x:Class="Wpe.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.UI}">

    <UserControl.Resources>
        <Style x:Key="LogGrid" TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Socket 日志 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Effect="{StaticResource Shadow.Card}" Margin="0,18,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="封包 / 注入日志" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center" />
                    <Button Content="清空" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Right"
                            Command="{Binding ClearSocketCommand}" />
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource Brush.Base}" BorderBrush="{StaticResource Brush.BorderSubtle}"
                        BorderThickness="1" CornerRadius="{StaticResource Radius.Md}">
                    <DataGrid ItemsSource="{Binding SocketLogs}" Style="{StaticResource LogGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding LogTime}" Width="110" />
                            <DataGridTextColumn Header="模块" Binding="{Binding FuncName}" Width="180" />
                            <DataGridTextColumn Header="内容" Binding="{Binding LogContent}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>

        <!-- 代理日志 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Effect="{StaticResource Shadow.Card}" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="SOCKS 代理日志" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center" />
                    <Button Content="清空" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Right"
                            Command="{Binding ClearProxyCommand}" />
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource Brush.Base}" BorderBrush="{StaticResource Brush.BorderSubtle}"
                        BorderThickness="1" CornerRadius="{StaticResource Radius.Md}">
                    <DataGrid ItemsSource="{Binding ProxyLogs}" Style="{StaticResource LogGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding LogTime}" Width="110" />
                            <DataGridTextColumn Header="模块" Binding="{Binding FuncName}" Width="180" />
                            <DataGridTextColumn Header="内容" Binding="{Binding LogContent}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
