<Window x:Class="Wpe.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Wpe.App.ViewModels"
        xmlns:ctl="clr-namespace:Wpe.App.Controls"
        Title="Winsock Packet Editor" Height="720" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:ShellViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- 侧边导航条目样式 -->
        <Style x:Key="NavItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="bd" CornerRadius="{StaticResource Radius.Sm}" Background="Transparent">
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="glyph" Grid.Column="0" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                           Text="{Binding Glyph}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13.5"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                           Text="{Binding Title}" />
                                <Border x:Name="rail" Grid.ColumnSpan="2" Width="3" HorizontalAlignment="Left"
                                        Margin="-12,8,0,8" CornerRadius="2"
                                        Background="{StaticResource Brush.Primary}" Opacity="0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Selected}" />
                                <Setter TargetName="rail" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 根边框：白底 + 细边，最大化时留出补偿边距 -->
    <Border x:Name="RootBorder" Background="{StaticResource Brush.Window}"
            BorderBrush="{StaticResource Brush.BorderDefault}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ 自绘标题栏（无系统白条） ============ -->
            <Grid Grid.Row="0" Background="{StaticResource Brush.Window}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/wpe.ico" Width="20" Height="20" />
                    <TextBlock Text="Winsock Packet Editor" FontSize="13" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextPrimary}" />
                    <Border Background="{StaticResource Brush.Sunken}" CornerRadius="4" Margin="10,0,0,0"
                            Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="x64" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" />
                    </Border>
                </StackPanel>

                <!-- 中间拖拽区（由 WindowChrome CaptionHeight 处理拖动） -->

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="BtnMin" Style="{StaticResource CaptionButton}" Click="OnMinimize"
                            ToolTip="最小化">
                        <Path Data="{StaticResource Icon.Minimize}" Stroke="{Binding Foreground,
                              RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                    </Button>
                    <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}" Click="OnMaximizeRestore"
                            ToolTip="最大化">
                        <Path x:Name="MaxIcon" Data="{StaticResource Icon.Maximize}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" Fill="Transparent" />
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseButton}" Click="OnClose"
                            ToolTip="关闭">
                        <Path Data="{StaticResource Icon.Close}" Stroke="{Binding Foreground,
                              RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ 主体：侧边导航 + 内容 ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="234" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 侧边栏 -->
                <Border Grid.Column="0" Background="{StaticResource Brush.Base}"
                        BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 品牌头 -->
                        <Border Grid.Row="0" Padding="22,18,22,6">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="9"
                                        Background="{StaticResource Brush.Primary}">
                                    <Image Source="/Assets/wpe.ico" Width="20" Height="20" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="WPE x64" FontSize="14.5" FontWeight="Bold"
                                               Foreground="{StaticResource Brush.TextPrimary}" />
                                    <TextBlock Text="Winsock Packet Editor" FontSize="10.5"
                                               Foreground="{StaticResource Brush.TextTertiary}" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="工作区" Style="{StaticResource Text.Caption}" Margin="24,14,0,6" />
                            <ListBox BorderThickness="0" Background="Transparent"
                                     ItemsSource="{Binding PrimaryItems}"
                                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource NavItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,8,0,12">
                            <Border Height="1" Background="{StaticResource Brush.BorderSubtle}" Margin="16,0,16,8" />
                            <ListBox BorderThickness="0" Background="Transparent"
                                     ItemsSource="{Binding FooterItems}"
                                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource NavItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 内容区 -->
                <Border Grid.Column="1" Background="{StaticResource Brush.Window}">
                    <ctl:FadeContentControl Content="{Binding CurrentContent}" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
