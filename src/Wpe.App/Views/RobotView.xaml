<UserControl x:Class="Wpe.App.Views.RobotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.UI}">

    <UserControl.Resources>
        <Style x:Key="RRow" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd" CornerRadius="{StaticResource Radius.Sm}"
                                Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Selected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,12,0,5" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
            <Button Content="新增机器人" Style="{StaticResource Button.Primary}" Command="{Binding AddCommand}" />
            <Button Content="删除" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Command="{Binding DeleteCommand}" />
            <Button Content="导入" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Command="{Binding LoadCommand}" />
            <Button Content="导出" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Command="{Binding SaveCommand}" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Effect="{StaticResource Shadow.Card}" Padding="4">
                <ListBox ItemsSource="{Binding Robots}" SelectedItem="{Binding Selected}"
                         ItemContainerStyle="{StaticResource RRow}" Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnable}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding RName}" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Effect="{StaticResource Shadow.Card}">
                <Grid Margin="4" IsEnabled="{Binding HasSelection}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="机器人名称" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                        <TextBox Text="{Binding RName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10">
                        <TextBlock Text="指令集" Style="{StaticResource Text.Subtle}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <Button Content="添加指令" Style="{StaticResource Button.Ghost}" Margin="14,0,0,0"
                                Command="{Binding AddInstructionCommand}" />
                    </StackPanel>

                    <Border Grid.Row="2" Background="{StaticResource Brush.Base}"
                            BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Md}">
                        <DataGrid ItemsSource="{Binding Instructions}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                  CanUserAddRows="False" GridLinesVisibility="None" Background="Transparent"
                                  BorderThickness="0" RowBackground="Transparent" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn Header="指令类型" Width="180"
                                                        SelectedItemBinding="{Binding Type}"
                                                        ElementStyle="{x:Null}">
                                    <DataGridComboBoxColumn.ItemsSource>
                                        <Binding Path="DataContext.InstructionTypes"
                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </DataGridComboBoxColumn.ItemsSource>
                                </DataGridComboBoxColumn>
                                <DataGridTextColumn Header="内容" Binding="{Binding Content}" Width="*"
                                                    FontFamily="{StaticResource Font.Mono}" />
                                <DataGridTemplateColumn Header="" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="删" Style="{StaticResource Button.Ghost}" Padding="6,2"
                                                    Command="{Binding DataContext.DeleteInstructionCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
