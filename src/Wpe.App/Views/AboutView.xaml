<UserControl x:Class="Wpe.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.UI}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0" Effect="{StaticResource Shadow.Card}"
                VerticalAlignment="Top">
            <StackPanel Margin="6">
                <StackPanel Orientation="Horizontal">
                    <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource Brush.Primary}">
                        <TextBlock Text="W" Foreground="White" FontSize="30" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Winsock Packet Editor x64" FontSize="18" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="内核版本 " Style="{StaticResource Text.Subtle}" />
                            <TextBlock Text="{Binding Version}" FontFamily="{StaticResource Font.Mono}"
                                       Foreground="{StaticResource Brush.Primary}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="{StaticResource Brush.BorderSubtle}" Margin="0,18" />

                <TextBlock TextWrapping="Wrap" Style="{StaticResource Text.Subtle}"
                           Text="本版本在完整保留原生 Winsock 钩子 / EasyHook 注入 / SOCKS 代理 / EF6+SQLite / OWIN 远程管理内核的基础上，采用 WPF 重构界面：无边框白主题、自绘标题栏（最小化/最大化/关闭）、矢量图标与硬件加速丝滑过渡。" />

                <Button Content="访问官网" Style="{StaticResource Button.Primary}" Margin="0,18,0,0"
                        HorizontalAlignment="Left" Command="{Binding OpenWebsiteCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
