<UserControl x:Class="Wpe.App.Views.InjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.UI}">

    <UserControl.Resources>
        <!-- 进程列表项样式（白主题 + 丝滑高亮） -->
        <Style x:Key="ProcessItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd" CornerRadius="{StaticResource Radius.Sm}"
                                Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Selected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面头部 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- 左：进程选择 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Effect="{StaticResource Shadow.Card}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="搜索进程名称…" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="刷新" Margin="8,0,0,0"
                                Style="{StaticResource Button.Ghost}" Command="{Binding RefreshCommand}" />
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource Brush.Base}"
                            CornerRadius="{StaticResource Radius.Md}"
                            BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1">
                        <ListBox ItemsSource="{Binding ProcessesView}"
                                 SelectedItem="{Binding SelectedProcess}"
                                 ItemContainerStyle="{StaticResource ProcessItem}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Path}" FontSize="11"
                                                       Foreground="{StaticResource Brush.TextTertiary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   Text="{Binding Pid}" FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="选择应用程序…" Style="{StaticResource Button.Ghost}"
                                Command="{Binding PickFileCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右：注入操作 + 日志 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Effect="{StaticResource Shadow.Card}">
                    <StackPanel Margin="4">
                        <TextBlock Text="目标进程" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" />
                        <TextBlock Text="{Binding SelectedProcess.Display, TargetNullValue=未选择}"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Content="注入进程" Style="{StaticResource Button.Primary}"
                                Command="{Binding InjectCommand}" Margin="0,14,0,0"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0"
                        Effect="{StaticResource Shadow.Card}">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="运行日志" Foreground="{StaticResource Brush.TextSecondary}"
                                   FontSize="12" Margin="0,0,0,8" />
                        <Border Grid.Row="1" Background="{StaticResource Brush.Sunken}"
                                CornerRadius="{StaticResource Radius.Md}" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Log}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="12" Foreground="{StaticResource Brush.TextPrimary}"
                                                       TextWrapping="Wrap" Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
