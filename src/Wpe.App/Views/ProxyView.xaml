<UserControl x:Class="Wpe.App.Views.ProxyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.UI}">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,12,0,5" />
        </Style>
        <Style x:Key="StatValue" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        </Style>
        <Style x:Key="StatCaption" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextTertiary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 状态条 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Effect="{StaticResource Shadow.Card}" Margin="0,18,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Brush.TextTertiary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsListening}" Value="True">
                                        <Setter Property="Fill" Value="#16A34A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="启动代理" Style="{StaticResource Button.Primary}" Command="{Binding StartCommand}" />
                    <Button Content="停止代理" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Command="{Binding StopCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- 配置 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Effect="{StaticResource Shadow.Card}">
                <StackPanel>
                    <TextBlock Text="监听设置" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" FontSize="14" />
                    <TextBlock Text="监听端口" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource Font.Mono}" VerticalContentAlignment="Center" Width="160" HorizontalAlignment="Left" />
                    <CheckBox Content="启用账号认证（SOCKS5 用户名/密码）" IsChecked="{Binding EnableAuth}" Margin="0,16,0,0"
                              Foreground="{StaticResource Brush.TextSecondary}" />
                    <CheckBox Content="不记录封包内容（仅统计）" IsChecked="{Binding NoRecord}" Margin="0,10,0,0"
                              Foreground="{StaticResource Brush.TextSecondary}" />
                    <CheckBox Content="极速模式（不缓存转发）" IsChecked="{Binding SpeedMode}" Margin="0,10,0,0"
                              Foreground="{StaticResource Brush.TextSecondary}" />

                    <Separator Margin="0,18" Background="{StaticResource Brush.BorderSubtle}" />

                    <TextBlock Text="外部代理链" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" FontSize="14" />
                    <CheckBox Content="启用外部代理" IsChecked="{Binding EnableExternalProxy}" Margin="0,12,0,0"
                              Foreground="{StaticResource Brush.TextSecondary}" />
                    <Grid Margin="0,10,0,0" IsEnabled="{Binding EnableExternalProxy}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="外部代理 IP / 域名" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ExternalProxyIP, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource Font.Mono}" VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="端口" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ExternalProxyPort, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource Font.Mono}" VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 实时统计 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Effect="{StaticResource Shadow.Card}">
                <StackPanel>
                    <TextBlock Text="实时统计" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" FontSize="14" />
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="{Binding TotalConnections}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="总连接数" Style="{StaticResource StatCaption}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="{Binding TcpConnections}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="TCP 连接" Style="{StaticResource StatCaption}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="{Binding UdpConnections}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="UDP 连接" Style="{StaticResource StatCaption}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding UplinkSpeed}" Style="{StaticResource StatValue}" />
                                <TextBlock Text=" / " Style="{StaticResource StatValue}" Foreground="{StaticResource Brush.TextTertiary}" />
                                <TextBlock Text="{Binding DownlinkSpeed}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <TextBlock Text="上行 / 下行 (KB/s)" Style="{StaticResource StatCaption}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
