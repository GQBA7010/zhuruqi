<UserControl x:Class="Wpe.App.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.UI}">

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 本地映射 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Effect="{StaticResource Shadow.Card}" Margin="0,18,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="本地映射 (MapLocal)" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="启用" IsChecked="{Binding EnableMapLocal}" Margin="16,0,0,0"
                                  VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
                    </StackPanel>
                    <Button Content="新增本地映射" Style="{StaticResource Button.Primary}" HorizontalAlignment="Right"
                            Command="{Binding AddLocalCommand}" />
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource Brush.Base}" BorderBrush="{StaticResource Brush.BorderSubtle}"
                        BorderThickness="1" CornerRadius="{StaticResource Radius.Md}">
                    <DataGrid ItemsSource="{Binding MapLocals}" AutoGenerateColumns="False" HeadersVisibility="Column"
                              CanUserAddRows="False" GridLinesVisibility="None" Background="Transparent"
                              BorderThickness="0" RowBackground="Transparent" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnable}" Width="52" />
                            <DataGridComboBoxColumn Header="协议" Width="80"
                                SelectedValueBinding="{Binding ProtocolType}"
                                SelectedValuePath="Value" DisplayMemberPath="Name">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <Binding Path="DataContext.Protocols" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn Header="主机" Binding="{Binding Host}" Width="*" />
                            <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="72" FontFamily="{StaticResource Font.Mono}" />
                            <DataGridTextColumn Header="远程路径" Binding="{Binding RemotePath}" Width="*" FontFamily="{StaticResource Font.Mono}" />
                            <DataGridTextColumn Header="本地文件" Binding="{Binding LocalPath}" Width="*" FontFamily="{StaticResource Font.Mono}" />
                            <DataGridTemplateColumn Header="" Width="56">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删" Style="{StaticResource Button.Ghost}" Padding="6,2"
                                                Command="{Binding DataContext.DeleteLocalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>

        <!-- 远程映射 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Effect="{StaticResource Shadow.Card}" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="远程映射 (MapRemote)" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="启用" IsChecked="{Binding EnableMapRemote}" Margin="16,0,0,0"
                                  VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
                    </StackPanel>
                    <Button Content="新增远程映射" Style="{StaticResource Button.Primary}" HorizontalAlignment="Right"
                            Command="{Binding AddRemoteCommand}" />
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource Brush.Base}" BorderBrush="{StaticResource Brush.BorderSubtle}"
                        BorderThickness="1" CornerRadius="{StaticResource Radius.Md}">
                    <DataGrid ItemsSource="{Binding MapRemotes}" AutoGenerateColumns="False" HeadersVisibility="Column"
                              CanUserAddRows="False" GridLinesVisibility="None" Background="Transparent"
                              BorderThickness="0" RowBackground="Transparent" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnable}" Width="52" />
                            <DataGridTextColumn Header="源主机" Binding="{Binding Host_From}" Width="*" />
                            <DataGridTextColumn Header="源端口" Binding="{Binding Port_From}" Width="72" FontFamily="{StaticResource Font.Mono}" />
                            <DataGridTextColumn Header="源路径" Binding="{Binding Path_From}" Width="*" FontFamily="{StaticResource Font.Mono}" />
                            <DataGridTextColumn Header="目标主机" Binding="{Binding Host_To}" Width="*" />
                            <DataGridTextColumn Header="目标端口" Binding="{Binding Port_To}" Width="72" FontFamily="{StaticResource Font.Mono}" />
                            <DataGridTextColumn Header="目标路径" Binding="{Binding Path_To}" Width="*" FontFamily="{StaticResource Font.Mono}" />
                            <DataGridTemplateColumn Header="" Width="56">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删" Style="{StaticResource Button.Ghost}" Padding="6,2"
                                                Command="{Binding DataContext.DeleteRemoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
