<UserControl x:Class="Wpe.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.UI}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 头部 -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0"
                           TextWrapping="Wrap" />
                <Border Background="{StaticResource Brush.Selected}" CornerRadius="8" Padding="10,4"
                        Margin="0,12,0,0" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding KernelVersion}" Foreground="{StaticResource Brush.Primary}"
                               FontSize="12" FontWeight="SemiBold" />
                </Border>
            </StackPanel>

            <!-- 模式入口 -->
            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Effect="{StaticResource Shadow.Card}">
                    <StackPanel Margin="6">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE945;" FontSize="30"
                                   Foreground="{StaticResource Brush.Primary}" />
                        <TextBlock Text="进程注入模式" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <TextBlock Text="将 Winsock 钩子注入目标进程，在目标内部实时拦截与编辑封包，支持 32/64 位与模拟器。"
                                   Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <Button Content="进入注入" Style="{StaticResource Button.Primary}" Margin="0,16,0,0"
                                HorizontalAlignment="Left" Command="{Binding GoInjectCommand}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Effect="{StaticResource Shadow.Card}">
                    <StackPanel Margin="6">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE968;" FontSize="30"
                                   Foreground="{StaticResource Brush.Primary}" />
                        <TextBlock Text="SOCKS 代理模式" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <TextBlock Text="以 SOCKS 代理方式转发并拦截流量，支持多协议、端口映射与代理账号体系。"
                                   Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <Button Content="进入代理" Style="{StaticResource Button.Primary}" Margin="0,16,0,0"
                                HorizontalAlignment="Left" Command="{Binding GoProxyCommand}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 远程管理 -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Effect="{StaticResource Shadow.Card}">
                <StackPanel Margin="6">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Content="启用远程管理" IsChecked="{Binding IsRemote}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="远程管理" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid Margin="0,14,0,0" IsEnabled="{Binding IsRemote}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="账号" Style="{StaticResource Text.Subtle}" Margin="2,0,0,4" />
                            <TextBox Text="{Binding RemoteUserName, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="密码" Style="{StaticResource Text.Subtle}" Margin="2,0,0,4" />
                            <TextBox Text="{Binding RemotePassWord, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="端口" Style="{StaticResource Text.Subtle}" Margin="2,0,0,4" />
                            <TextBox Width="90" Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <DockPanel Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Content="保存" Style="{StaticResource Button.Primary}"
                                Command="{Binding SaveRemoteCommand}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="管理地址：" Style="{StaticResource Text.Subtle}" />
                            <TextBlock Text="{Binding RemoteUrl}" Foreground="{StaticResource Brush.Primary}"
                                       FontFamily="{StaticResource Font.Mono}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 语言与备份 -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,0" Effect="{StaticResource Shadow.Card}">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="中文" Style="{StaticResource Button.Ghost}" Command="{Binding SetChineseCommand}" />
                        <Button Content="English" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                Command="{Binding SetEnglishCommand}" />
                        <Button Content="导入备份" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                Command="{Binding ImportBackupCommand}" />
                        <Button Content="官网 / 关于" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                Command="{Binding OpenWebsiteCommand}" />
                    </StackPanel>
                    <TextBlock Text="界面语言、数据备份与帮助" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
