<UserControl x:Class="Wpe.App.Views.FilterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.UI}">

    <UserControl.Resources>
        <Style x:Key="FRow" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd" CornerRadius="{StaticResource Radius.Sm}"
                                Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Selected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,12,0,5" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
            <Button Content="新增规则" Style="{StaticResource Button.Primary}" Command="{Binding AddCommand}" />
            <Button Content="删除" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Command="{Binding DeleteCommand}" />
            <Button Content="全部启用" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Command="{Binding EnableAllCommand}" />
            <Button Content="全部停用" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Command="{Binding DisableAllCommand}" />
            <Button Content="导入" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Command="{Binding LoadCommand}" />
            <Button Content="导出" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Command="{Binding SaveCommand}" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- 规则列表 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Effect="{StaticResource Shadow.Card}" Padding="4">
                <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Selected}"
                         ItemContainerStyle="{StaticResource FRow}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnable}" VerticalAlignment="Center"
                                          Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding FName}" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding ExecutionCount}" VerticalAlignment="Center"
                                           FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                           Foreground="{StaticResource Brush.TextTertiary}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 规则编辑 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Effect="{StaticResource Shadow.Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4" IsEnabled="{Binding HasSelection}">
                        <TextBlock Text="规则名称" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                        <TextBox Text="{Binding FName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="模式" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ModeOptions}" DisplayMemberPath="Name"
                                          SelectedValuePath="Value" SelectedValue="{Binding FMode}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="动作" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ActionOptions}" DisplayMemberPath="Name"
                                          SelectedValuePath="Value" SelectedValue="{Binding FAction}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="作用函数" Style="{StaticResource FieldLabel}" />
                        <WrapPanel>
                            <CheckBox Content="Send" IsChecked="{Binding FnSend}" Margin="0,0,16,6" />
                            <CheckBox Content="SendTo" IsChecked="{Binding FnSendTo}" Margin="0,0,16,6" />
                            <CheckBox Content="Recv" IsChecked="{Binding FnRecv}" Margin="0,0,16,6" />
                            <CheckBox Content="RecvFrom" IsChecked="{Binding FnRecvFrom}" Margin="0,0,16,6" />
                            <CheckBox Content="WSASend" IsChecked="{Binding FnWSASend}" Margin="0,0,16,6" />
                            <CheckBox Content="WSASendTo" IsChecked="{Binding FnWSASendTo}" Margin="0,0,16,6" />
                            <CheckBox Content="WSARecv" IsChecked="{Binding FnWSARecv}" Margin="0,0,16,6" />
                            <CheckBox Content="WSARecvFrom" IsChecked="{Binding FnWSARecvFrom}" Margin="0,0,16,6" />
                        </WrapPanel>

                        <TextBlock Text="查找内容（HEX）" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding FSearch, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource Font.Mono}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="60" VerticalContentAlignment="Top" />

                        <TextBlock Text="替换/修改内容（HEX）" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding FModify, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource Font.Mono}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="60" VerticalContentAlignment="Top" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
