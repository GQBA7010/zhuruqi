<UserControl x:Class="Wpe.App.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Wpe.App.Converters"
             FontFamily="{StaticResource Font.UI}">

    <UserControl.Resources>
        <conv:PacketTypeToNameConverter x:Key="TypeName" />
        <conv:PacketTypeToBrushConverter x:Key="TypeBrush" />
        <conv:PacketTypeToArrowConverter x:Key="TypeArrow" />

        <!-- 封包列表行样式 -->
        <Style x:Key="PacketRow" TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Height" Value="30" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Hover}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Selected}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PacketCell" TargetType="{x:Type DataGridCell}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" VerticalAlignment="Top" Background="{StaticResource Brush.Sunken}"
                    CornerRadius="{StaticResource Radius.Sm}" Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="封包总数" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PacketCount}" Margin="8,0,0,0" FontWeight="SemiBold"
                               FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
            <Button Content="清空" Style="{StaticResource Button.Ghost}" Command="{Binding CleanUpCommand}" />
            <Button Content="保存封包" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                    Command="{Binding SaveCommand}" />
            <Button Content="滤镜规则" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                    Command="{Binding FilterCommand}" />
            <Button Content="发送封包" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                    Command="{Binding SendCommand}" />
            <Button Content="对比" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                    Command="{Binding CompareCommand}" />
            <CheckBox Content="自动滚动" IsChecked="{Binding AutoRoll}" Margin="16,0,0,0"
                      VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
            <CheckBox Content="自动清理" IsChecked="{Binding AutoClear}" Margin="14,0,0,0"
                      VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
        </StackPanel>

        <!-- 查找栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <TextBox Width="200" VerticalContentAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding FindCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <CheckBox Content="HEX" IsChecked="{Binding SearchIsHex}" Margin="10,0,0,0"
                      VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
            <Button Content="查找" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Command="{Binding FindCommand}" />
            <Button Content="清除" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Command="{Binding ClearSearchCommand}" />
        </StackPanel>

        <!-- 列表 + 十六进制详情 -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Effect="{StaticResource Shadow.Card}" Padding="4">
                <DataGrid ItemsSource="{Binding Packets}"
                          SelectedItem="{Binding SelectedPacket}"
                          AutoGenerateColumns="False" HeadersVisibility="Column"
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                          GridLinesVisibility="None" Background="Transparent" BorderThickness="0"
                          RowBackground="Transparent" SelectionMode="Single"
                          RowStyle="{StaticResource PacketRow}" CellStyle="{StaticResource PacketCell}"
                          FontSize="12" EnableRowVirtualization="True">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Background" Value="{StaticResource Brush.Base}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="8,7" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="类型" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding PacketType, Converter={StaticResource TypeArrow}}"
                                                   Foreground="{Binding PacketType, Converter={StaticResource TypeBrush}}"
                                                   FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PacketType, Converter={StaticResource TypeName}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="套接字" Binding="{Binding PacketSocket}" Width="80"
                                            FontFamily="{StaticResource Font.Mono}" />
                        <DataGridTextColumn Header="源地址" Binding="{Binding PacketFrom}" Width="*" />
                        <DataGridTextColumn Header="目的地址" Binding="{Binding PacketTo}" Width="*" />
                        <DataGridTextColumn Header="长度" Binding="{Binding PacketLen}" Width="64"
                                            FontFamily="{StaticResource Font.Mono}" />
                        <DataGridTextColumn Header="数据（HEX）" Binding="{Binding PacketData}" Width="2*"
                                            FontFamily="{StaticResource Font.Mono}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 十六进制详情 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Effect="{StaticResource Shadow.Card}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="十六进制详情" Foreground="{StaticResource Brush.TextSecondary}"
                               FontSize="12" Margin="0,0,0,8" />
                    <Border Grid.Row="1" Background="{StaticResource Brush.Sunken}"
                            CornerRadius="{StaticResource Radius.Md}" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding HexDump, Mode=OneWay}" IsReadOnly="True"
                                     Background="Transparent" BorderThickness="0"
                                     FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                     Foreground="{StaticResource Brush.TextPrimary}"
                                     TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
