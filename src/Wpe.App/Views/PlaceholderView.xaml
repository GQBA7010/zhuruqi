<UserControl x:Class="Wpe.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.UI}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面头部 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- 内容占位卡片 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0"
                Effect="{StaticResource Shadow.Card}"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7C0;" FontSize="42"
                           HorizontalAlignment="Center" Foreground="{StaticResource Brush.Primary}" />
                <TextBlock Text="该功能正在按商业级标准迁移中" Margin="0,14,0,0" FontSize="15"
                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                <Border Background="{StaticResource Brush.Selected}" CornerRadius="10" Padding="10,4"
                        Margin="0,10,0,0" HorizontalAlignment="Center">
                    <TextBlock Foreground="{StaticResource Brush.Primary}" FontSize="12">
                        <Run Text="规划阶段 " /><Run Text="{Binding Phase}" FontWeight="SemiBold" />
                    </TextBlock>
                </Border>
                <TextBlock Text="外壳、白主题、自绘标题栏与丝滑过渡已就绪；核心逻辑与各功能页正逐阶段 1:1 迁移。"
                           Style="{StaticResource Text.Subtle}" Margin="0,14,0,0" MaxWidth="460"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
