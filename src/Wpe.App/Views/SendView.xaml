<UserControl x:Class="Wpe.App.Views.SendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Wpe.App.Converters"
             FontFamily="{StaticResource Font.UI}">

    <UserControl.Resources>
        <conv:PacketTypeToNameConverter x:Key="TypeName" />
        <conv:PacketTypeToBrushConverter x:Key="TypeBrush" />
        <conv:PacketTypeToArrowConverter x:Key="TypeArrow" />

        <Style x:Key="SRow" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd" CornerRadius="{StaticResource Radius.Sm}"
                                Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Selected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,12,0,5" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Subtle}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
            <Button Content="新增任务" Style="{StaticResource Button.Primary}" Command="{Binding AddCommand}" />
            <Button Content="删除" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Command="{Binding DeleteCommand}" />
            <Button Content="导入" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Command="{Binding LoadCommand}" />
            <Button Content="导出" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Command="{Binding SaveCommand}" />
            <Button Content="立即发送" Style="{StaticResource Button.Primary}" Margin="16,0,0,0" Command="{Binding SendCommand}" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <!-- 任务列表 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Effect="{StaticResource Shadow.Card}" Padding="4">
                <ListBox ItemsSource="{Binding SendTasks}" SelectedItem="{Binding Selected}"
                         ItemContainerStyle="{StaticResource SRow}" Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnable}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding SName}" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding SCollection.Count, StringFormat={}{0} 包}"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="{StaticResource Brush.TextTertiary}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 任务编辑 + 封包集合 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Effect="{StaticResource Shadow.Card}">
                <Grid Margin="4" IsEnabled="{Binding HasSelection}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="任务名称" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                        <TextBox Text="{Binding SName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="循环次数" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding SLoopCNT, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource Font.Mono}" VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="间隔(ms)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding SLoopINT, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource Font.Mono}" VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                <CheckBox Content="使用系统套接字" IsChecked="{Binding SSystemSocket}" Margin="0,0,0,8"
                                          Foreground="{StaticResource Brush.TextSecondary}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="备注" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SNotes, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        <TextBlock Text="封包集合" Style="{StaticResource FieldLabel}" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource Brush.Base}"
                            BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Md}">
                        <DataGrid ItemsSource="{Binding Packets}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                  CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="None"
                                  Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="类型" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                                <TextBlock Text="{Binding PacketType, Converter={StaticResource TypeArrow}}"
                                                           Foreground="{Binding PacketType, Converter={StaticResource TypeBrush}}"
                                                           FontWeight="Bold" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding PacketType, Converter={StaticResource TypeName}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="套接字" Binding="{Binding PacketSocket}" Width="80" />
                                <DataGridTextColumn Header="长度" Binding="{Binding PacketLen}" Width="64" />
                                <DataGridTextColumn Header="数据（HEX）" Binding="{Binding PacketData}" Width="*"
                                                    FontFamily="{StaticResource Font.Mono}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
