<Application x:Class="Wpe.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Wpe.App.ViewModels"
             xmlns:views="clr-namespace:Wpe.App.Views"
             StartupUri="Views/ShellWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palette.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/WindowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 页面 ViewModel -> View 映射 -->
            <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
                <views:PlaceholderView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InjectViewModel}">
                <views:InjectView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EditorViewModel}">
                <views:EditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FilterViewModel}">
                <views:FilterView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SendViewModel}">
                <views:SendView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <views:AboutView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
